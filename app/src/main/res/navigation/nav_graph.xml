<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.alphaflix.app.ui.home.HomeFragment"
        android:label="الرئيسية"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_search"
            app:destination="@id/searchFragment" />
    </fragment>

    <fragment
        android:id="@+id/moviesFragment"
        android:name="com.alphaflix.app.ui.movies.MoviesFragment"
        android:label="الأفلام"
        tools:layout="@layout/fragment_media_grid" />

    <fragment
        android:id="@+id/seriesFragment"
        android:name="com.alphaflix.app.ui.series.SeriesFragment"
        android:label="المسلسلات"
        tools:layout="@layout/fragment_media_grid" />

    <fragment
        android:id="@+id/channelsFragment"
        android:name="com.alphaflix.app.ui.channels.ChannelsFragment"
        android:label="البث المباشر"
        tools:layout="@layout/fragment_channels" />

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.alphaflix.app.ui.search.SearchFragment"
        android:label="بحث"
        tools:layout="@layout/fragment_search" />

</navigation>
